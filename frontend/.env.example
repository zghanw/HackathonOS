# Supabase project URL + publishable (anon) key — safe to expose in the client by design.
# Get both from: Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Service-role (secret) key. ONLY for scripts/retention-sweep.mjs, which must
# bypass RLS to see live teams. NEVER expose this in the client or commit a real
# value. Prefer passing it as an env var: SUPABASE_SERVICE_ROLE_KEY=... npm run sweep
SUPABASE_SERVICE_ROLE_KEY=
